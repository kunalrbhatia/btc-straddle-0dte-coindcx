# CoinDCX API Credentials (HMAC)
COINDCX_API_KEY=your_api_key_here
COINDCX_API_SECRET=your_api_secret_here

# CoinDCX Options JWT Web Session Token (from browser Authorization header)
# Token is IP-bound and valid for ~36h. You can set it directly or point to a file.
# With the zero-touch refresher below configured, you do NOT need to paste this by
# hand — scripts/refresh-session.cjs mints it server-side and writes it to the file.
COINDCX_SESSION_TOKEN=your_bearer_token_here
COINDCX_SESSION_FILE=./session.token

# --- Zero-touch session refresher (scripts/refresh-session.cjs) ----------------
# The options API only accepts a WEB SESSION token whose `sip` claim matches the
# calling IP. So the session must be minted FROM the machine that will trade.
# This headless browser login does that: email + password, then the 6-digit email
# OTP (fetched from Gmail over IMAP) and the authenticator TOTP code.
#
# ⚠️  SECURITY: these are full account credentials. Keep .env at 600 and never
# commit it. Changing your CoinDCX password instantly revokes every session.
COINDCX_WEB_EMAIL=
COINDCX_WEB_PASSWORD=
# Base32 authenticator secret (the setup string, NOT the 6-digit code).
# Leave blank if 2FA is SMS/email only — the script then waits for a manual code.
COINDCX_TOTP_SECRET=
# Gmail mailbox used to read the CoinDCX email OTP. Use a Google *App Password*
# (16 chars) — not your account password. GMAIL_USER defaults to COINDCX_WEB_EMAIL.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Keeping it fresh unattended ----------------------------------------------
# scripts/refresh-session.cjs is safe to run repeatedly; the browser profile is
# persisted under state/browser-profile (gitignored), which often lets repeat runs
# reuse the existing session instead of performing a full login again.
# Recommended: run it hourly via cron and let it refresh only when the token is
# close to expiry (see ~/.hermes/scripts/btc-session-refresh.sh for that pattern).

# Strategy Settings
ORDER_QUANTITY=0.01
LEVERAGE=10
MARGIN_CURRENCY=USDT
CONVERSION_RATE=102
STRIKE_STEP=250
EXECUTION_HOUR_IST=18
EXECUTION_MINUTE_IST=15

# Risk Management Settings
SL_MULTIPLIER=2.0
PROFIT_TARGET_RATIO=0.55
POLL_INTERVAL_MS=2000
MAX_MONITOR_MINUTES=720

# Safe Mode / Testing
DRY_RUN=false
ALLOW_INSTANT_EXECUTION=false

# Telegram Alerts (optional, silently disabled if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

