# CoinDCX API Credentials (HMAC)
COINDCX_API_KEY=your_api_key_here
COINDCX_API_SECRET=your_api_secret_here

# CoinDCX Options JWT Web Session Token (from browser Authorization header)
# Token is IP-bound and valid for ~36h. You can set it directly or point to a file.
COINDCX_SESSION_TOKEN=your_bearer_token_here
COINDCX_SESSION_FILE=./session.token

# Strategy Settings
ORDER_QUANTITY=0.01
LEVERAGE=10
MARGIN_CURRENCY=USDT
# FALLBACK ONLY: the bot sends the live USDT/INR rate (read per entry from CoinDCX
# public market data). This value is used solely when that lookup fails.
CONVERSION_RATE=102
STRIKE_STEP=250

# Schedule & Expiry (Single Source of Truth: .env)
# EXECUTION_HOUR_IST (0-23) and EXECUTION_MINUTE_IST (0-59) are REQUIRED with NO hidden defaults.
EXECUTION_HOUR_IST=18
EXECUTION_MINUTE_IST=15
# PM2 process restart lead time in minutes before entry (default 45). Handled in ecosystem.config.js.
RESTART_LEAD_MINUTES=45
# Daily options contract expiry hour in UTC (0-23, default 8 = 13:30 IST).
DAILY_EXPIRY_HOUR_UTC=8

ENTRY_ORDER_TYPE=Limit
ENTRY_FILL_TIMEOUT_MS=15000

# Risk Management Settings
SL_MULTIPLIER=2.0
PROFIT_TARGET_RATIO=0.55
POLL_INTERVAL_MS=2000
# Monitor window cutoff in minutes (default 1380 = 23h, sized for ~23h holds from afternoon entry to 13:30 IST expiry)
MAX_MONITOR_MINUTES=1380

# Safe Mode / Testing
DRY_RUN=false
ALLOW_INSTANT_EXECUTION=false

# Telegram Alerts (optional, silently disabled if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily Report Settings
# Delay after contract expiry in minutes before generating and committing report (0-180, default 15)
REPORT_DELAY_MINUTES=15
REPORT_GIT_AUTHOR_NAME="btc-straddle-0dte bot"
REPORT_GIT_AUTHOR_EMAIL="bot@straddle-btc-0dte.local"

