# CoinDCX API Credentials (HMAC)
COINDCX_API_KEY=your_api_key_here
COINDCX_API_SECRET=your_api_secret_here

# CoinDCX Options JWT Web Session Token (from browser Authorization header)
# Token is IP-bound and valid for ~36h. You can set it directly or point to a file.
COINDCX_SESSION_TOKEN=your_bearer_token_here
COINDCX_SESSION_FILE=./session.token

# Strategy Settings
ORDER_QUANTITY=0.01
LEVERAGE=10
MARGIN_CURRENCY=USDT
# FALLBACK ONLY: the bot sends the live USDT/INR rate (read per entry from CoinDCX
# public market data). This value is used solely when that lookup fails.
CONVERSION_RATE=102
STRIKE_STEP=250

# Schedule & Expiry (Single Source of Truth: .env)
# EXECUTION_HOUR_IST (0-23) and EXECUTION_MINUTE_IST (0-59) are REQUIRED with NO hidden defaults.
EXECUTION_HOUR_IST=18
EXECUTION_MINUTE_IST=15
# PM2 process restart lead time in minutes before entry (default 45). Handled in ecosystem.config.js.
RESTART_LEAD_MINUTES=45
# Daily options contract expiry hour in UTC (0-23, default 8 = 13:30 IST).
DAILY_EXPIRY_HOUR_UTC=8

ENTRY_ORDER_TYPE=Limit
ENTRY_FILL_TIMEOUT_MS=15000

# Risk Management Settings
SL_MULTIPLIER=2.0
PROFIT_TARGET_RATIO=0.55
POLL_INTERVAL_MS=2000
# Monitor window cutoff in minutes (default 1380 = 23h, sized for ~23h holds from afternoon entry to 13:30 IST expiry)
MAX_MONITOR_MINUTES=1380
# Overrun tolerance beyond SL trigger before fallback close (default 0.10 = 10%)
SL_OVERRUN_TOLERANCE=0.10
# Cost stop on surviving leg when one leg stops out (default true)
COST_STOP_ENABLED=true
# Must be > 0 (buffer of 0 is unconstructible: stop would fire immediately upon sell creation)
COST_STOP_BUFFER_POINTS=20
# Action if current mark is already above cost trigger ('keep' | 'close', default keep)
COST_STOP_ON_OVERDUE=keep
# Grace period in ms after entry fill during which position feed absence is treated as feed lag (default 60000 = 60s)
POSITION_TRUTH_GRACE_MS=60000

# Safe Mode / Testing
DRY_RUN=false
ALLOW_INSTANT_EXECUTION=false

# Telegram Alerts (optional, silently disabled if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily Report Settings
# Delay after contract expiry in minutes before generating and committing report (0-180, default 15)
REPORT_DELAY_MINUTES=15
REPORT_GIT_AUTHOR_NAME="btc-straddle-0dte bot"
REPORT_GIT_AUTHOR_EMAIL="bot@straddle-btc-0dte.local"

# Cycle Record & Venue Verification Settings
RECORD_DIR=./records
VERIFICATION_TOLERANCE=1.0
CHECKPOINT_INTERVAL_MS=300000
WALLET_PAGE_CAP=10


# --- 1 DTE strategy parameters (pinned explicitly 2026-10-11; these match the code defaults in use) ---
# Entry 22:45 IST, exit 17:45 IST the following day, strangle legs must price in the band below.
ONEDTE_ENTRY_HOUR_IST=22
ONEDTE_ENTRY_MINUTE_IST=45
ONEDTE_EXIT_HOUR_IST=17
ONEDTE_EXIT_MINUTE_IST=45
ONEDTE_MIN_PREMIUM=100
ONEDTE_MAX_PREMIUM=150
ONEDTE_SL_MULTIPLIER=2.0
ONEDTE_POLL_INTERVAL_MS=3000
ONEDTE_ORDER_QUANTITY=0.01
ONEDTE_LEVERAGE=10
ONEDTE_ENTRY_ORDER_TYPE=Limit
ONEDTE_STATE_DIR=./state

# Profit target: exit once this share of the credit sold is earned (0.5 = 50%).
ONEDTE_PROFIT_TARGET_RATIO=0.50

# Option prices must be a multiple of this tick (venue rule).
ONEDTE_PRICE_TICK=5

# Premium price source: 'bid' | 'mark' (default 'bid' off the order book)
ONEDTE_PREMIUM_SOURCE=bid

# Allow out-of-band strike selection fallback (default false; aborts entry if no strike in band)
ONEDTE_ALLOW_OUT_OF_BAND_FALLBACK=false

# Requote cadence in milliseconds if resting order has not filled on venue (default 5000)
ONEDTE_REQUOTE_AFTER_MS=5000

# Maximum number of requotes before cancelling unfilled orders and unwinding (default 2)
ONEDTE_MAX_REQUOTES=2
