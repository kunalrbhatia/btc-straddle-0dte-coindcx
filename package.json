{
  "name": "straddle-btc-0dte",
  "version": "1.0.0",
  "description": "CoinDCX BTC 0DTE ATM Straddle Automated Seller",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "plan": "ts-node src/plan.ts",
    "run-once": "RUN_ONCE=true ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "test:auth": "ts-node src/testAuth.ts",
    "refresh-session": "node scripts/refresh-session.cjs",
    "scan-secrets": "node scripts/pre-commit-secrets.cjs",
    "verify:hooks": "node scripts/verify-hooks.cjs",
    "report": "ts-node src/reportCli.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "coindcx",
    "bitcoin",
    "straddle",
    "0dte",
    "options",
    "crypto"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "imapflow": "^2.2.3",
    "playwright": "^1.63.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
